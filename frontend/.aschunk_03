                      <span className="shrink-0 font-mono text-[10px] uppercase tracking-[0.12em] text-ground/40">
                        {item.detail}
                      </span>
                    </Link>
                  </li>
                ))}
              </ul>
              <p className="mt-6 max-w-sm font-mono text-[10px] leading-relaxed tracking-wide text-ground/40">
