["\"\"\"Seed durable CAITECH demo dataset. Manual clear_demo only.\"\"\"","from __future__ import annotations","from datetime import timedelta","from decimal import Decimal","from django.contrib.auth import get_user_model","from django.core.management.base import BaseCommand","from django.db import transaction","from django.utils import timezone","from courses.models import (","    Assignment, AssignmentSubmission, Category, Choice, Course, CourseReview,","    Enrollment, Lesson, LessonProgress, Question, Quiz, QuizAttempt, Section,",")","from site_content.models import BlogPost","","User = get_user_model()","TAG = \"[DEMO]\"","PW = \"CaitechDemo2026!\"","","def ensure_user(username, email, **flags):","    u, _ = User.objects.get_or_create(username=username, defaults={\"email\": email, **flags})","    for k, v in flags.items():","        setattr(u, k, v)","    u.email = email","    u.set_password(PW)","    u.save()","    return u","","def ensure_cat(name, desc):","    c, _ = Category.objects.get_or_create(name=name, defaults={\"description\": desc})","    return c","","def ensure_course(slug, **kw):","    c, _ = Course.objects.update_or_create(slug=slug, defaults=kw)","    return c","","def ensure_section(course, title, order):","    s, _ = Section.objects.update_or_create(course=course, order=order, defaults={\"title\": title})","    return s","","def ensure_lesson(section, title, order, preview=False, minutes=25):","    l, _ = Lesson.objects.update_or_create(","        section=section, order=order,","        defaults={\"title\": title, \"is_preview\": preview, \"duration_minutes\": minutes, \"video_url\": \"\"},","    )","    return l","","class Command(BaseCommand):","    help = \"Seed durable CAITECH demo data for QA and client demos.\"","","    @transaction.atomic","    def handle(self, *args, **options):","        self.stdout.write(\"Seeding demo...\")","        student = ensure_user(","            \"demo.student\", \"demo.student@caitech.test\",","            first_name=\"Demo\", last_name=\"Student\", is_student=True,","            is_instructor=False, is_verified_instructor=False, is_staff=False, is_superuser=False,","        )","        instructor = ensure_user(","            \"demo.instructor\", \"demo.instructor@caitech.test\",","            first_name=\"Demo\", last_name=\"Instructor\", is_student=False,","            is_instructor=True, is_verified_instructor=True, is_staff=False, is_superuser=False,","        )","        ensure_user(","            \"demo.admin\", \"demo.admin@caitech.test\",","            first_name=\"Demo\", last_name=\"Admin\", is_student=False,","            is_instructor=True, is_verified_instructor=True, is_staff=True, is_superuser=True,","        )","        cad = ensure_cat(f\"{TAG} School of CAD & Technology\", \"Demo CAD / digital construction school.\")","        ictc = ensure_cat(f\"{TAG} School of ICT\", \"Demo ICT school.\")","        build = ensure_cat(f\"{TAG} School of Building Technology\", \"Demo building technology school.\")"]