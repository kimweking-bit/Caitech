["\"\"\"Seed durable CAITECH demo dataset. Manual clear_demo only.\"\"\"","from __future__ import annotations","from datetime import timedelta","from decimal import Decimal","from django.contrib.auth import get_user_model","from django.core.management.base import BaseCommand","from django.db import transaction","from django.utils import timezone","from courses.models import (","    Assignment, AssignmentSubmission, Category, Choice, Course, CourseReview,","    Enrollment, Lesson, LessonProgress, Question, Quiz, QuizAttempt, Section,",")","from site_content.models import BlogPost","","User = get_user_model()","TAG = \"[DEMO]\"","PW = \"CaitechDemo2026!\"","","def ensure_user(username, email, **flags):","    u, _ = User.objects.get_or_create(username=username, defaults={\"email\": email, **flags})","    for k, v in flags.items():","        setattr(u, k, v)","    u.email = email","    u.set_password(PW)","    u.save()","    return u","","def ensure_cat(name, desc):","    c, _ = Category.objects.get_or_create(name=name, defaults={\"description\": desc})","    return c","","def ensure_course(slug, **kw):","    c, _ = Course.objects.update_or_create(slug=slug, defaults=kw)","    return c","","def ensure_section(course, title, order):","    s, _ = Section.objects.update_or_create(course=course, order=order, defaults={\"title\": title})","    return s","","def ensure_lesson(section, title, order, preview=False, minutes=25):","    l, _ = Lesson.objects.update_or_create(","        section=section, order=order,","        defaults={\"title\": title, \"is_preview\": preview, \"duration_minutes\": minutes, \"video_url\": \"\"},","    )","    return l","","class Command(BaseCommand):","    help = \"Seed durable CAITECH demo data for QA and client demos.\"","","    @transaction.atomic","    def handle(self, *args, **options):","        self.stdout.write(\"Seeding demo...\")","        student = ensure_user(","            \"demo.student\", \"demo.student@caitech.test\",","            first_name=\"Demo\", last_name=\"Student\", is_student=True,","            is_instructor=False, is_verified_instructor=False, is_staff=False, is_superuser=False,","        )","        instructor = ensure_user(","            \"demo.instructor\", \"demo.instructor@caitech.test\",","            first_name=\"Demo\", last_name=\"Instructor\", is_student=False,","            is_instructor=True, is_verified_instructor=True, is_staff=False, is_superuser=False,","        )","        ensure_user(","            \"demo.admin\", \"demo.admin@caitech.test\",","            first_name=\"Demo\", last_name=\"Admin\", is_student=False,","            is_instructor=True, is_verified_instructor=True, is_staff=True, is_superuser=True,","        )","        cad = ensure_cat(f\"{TAG} School of CAD & Technology\", \"Demo CAD / digital construction school.\")","        ictc = ensure_cat(f\"{TAG} School of ICT\", \"Demo ICT school.\")","        build = ensure_cat(f\"{TAG} School of Building Technology\", \"Demo building technology school.\")","        bim = ensure_course(","            \"demo-bim-digital-construction\",","            title=f\"{TAG} BIM & Digital Construction Practice\",","            short_description=\"Six-module DEMO path from CAD foundations to coordinated BIM documentation.\",","            description=(","                \"Demo programme for client walkthroughs. Six modular units map CAD foundations through \"","                \"Revit modelling, coordination and documentation. Labelled DEMO — not official CAITECH curriculum.\"","            ),","            category=cad, instructor=instructor,","            price=Decimal(\"45000.00\"), original_price=Decimal(\"52000.00\"),","            level=Course.Level.INTERMEDIATE, duration=\"6 months · 6 modules\",","            course_type=Course.CourseType.CERTIFICATE,","            delivery_modes=[Course.DeliveryMode.PHYSICAL, Course.DeliveryMode.ONLINE],","            intake_status=Course.IntakeStatus.ONGOING,","            learning_outcomes=[","                \"Produce coordinated BIM models for building elements\",","                \"Apply CAD drafting standards used in technical practice contexts\",","                \"Document sheets and schedules for review packages\",","                \"Collaborate on model exchanges and clash notes\",","            ],","            skills_gained=[\"AutoCAD\", \"Revit\", \"BIM coordination\", \"Technical documentation\"],","            tools_covered=[\"AutoCAD\", \"Revit\", \"Navisworks (intro)\", \"PDF markup tools\"],","            is_published=True, is_available=True,","        )","        mods = [","            ensure_section(bim, \"Module 1 — CAD foundations\", 1),","            ensure_section(bim, \"Module 2 — Architectural modelling in Revit\", 2),","            ensure_section(bim, \"Module 3 — Structure & documentation\", 3),","            ensure_section(bim, \"Module 4 — Coordination workflows\", 4),","            ensure_section(bim, \"Module 5 — Project package\", 5),","            ensure_section(bim, \"Module 6 — Review & professional practice\", 6),","        ]","        lessons = [","            ensure_lesson(mods[0], \"Welcome & studio expectations\", 1, True, 12),","            ensure_lesson(mods[0], \"Drawing standards and layers\", 2, True, 28),","            ensure_lesson(mods[0], \"2D drafting drills\", 3, False, 35),","            ensure_lesson(mods[1], \"Revit project setup\", 1, False, 30),","            ensure_lesson(mods[1], \"Walls, floors and roofs\", 2, False, 40),","            ensure_lesson(mods[1], \"Views and sheets\", 3, False, 32),","            ensure_lesson(mods[2], \"Structural grids and levels\", 1, False, 30),","            ensure_lesson(mods[2], \"Schedules and tags\", 2, False, 28),","            ensure_lesson(mods[3], \"Model exchange basics\", 1, False, 26),","            ensure_lesson(mods[3], \"Clash note workflow\", 2, False, 30),","            ensure_lesson(mods[4], \"Issue set preparation\", 1, False, 34),","            ensure_lesson(mods[5], \"Portfolio critique checklist\", 1, False, 22),","        ]","        quiz, _ = Quiz.objects.update_or_create(","            course=bim, title=f\"{TAG} Module 1 knowledge check\",","            defaults={\"description\": \"Short demo quiz on CAD standards.\", \"max_attempts\": 3},","        )","        Question.objects.filter(quiz=quiz).delete()","        q1 = Question.objects.create(quiz=quiz, prompt=\"Which practice keeps CAD files legible across teams?\", order=1, points=Decimal(\"1.00\"))","        Choice.objects.create(question=q1, text=\"Consistent layer naming and standards\", is_correct=True, order=1)","        Choice.objects.create(question=q1, text=\"Random colours on every object\", is_correct=False, order=2)","        Choice.objects.create(question=q1, text=\"Deleting unused standards\", is_correct=False, order=3)","        q2 = Question.objects.create(quiz=quiz, prompt=\"A preview lesson is intended for:\", order=2, points=Decimal(\"1.00\"))","        Choice.objects.create(question=q2, text=\"Prospective learners before full enrolment\", is_correct=True, order=1)","        Choice.objects.create(question=q2, text=\"Staff payroll only\", is_correct=False, order=2)","        asg, _ = Assignment.objects.update_or_create(","            course=bim, title=f\"{TAG} Drafting standards sheet\",","            defaults={","                \"description\": \"Submit a short note describing your layer strategy for a small floor plan. DEMO coursework.\",","                \"due_at\": timezone.now() + timedelta(days=21),","                \"max_points\": Decimal(\"100.00\"),","            },","        )"]